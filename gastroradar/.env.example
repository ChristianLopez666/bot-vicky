# Copiar como variables de entorno en Render. NUNCA subir valores reales.
GASTRORADAR_ENABLED=false

# WhatsApp Cloud API (numero de Vicky Redes, previa verificacion)
META_TOKEN=
META_APP_SECRET=
VERIFY_TOKEN=
# Phone Number ID (no es el ID de la cuenta WABA)
WABA_PHONE_ID=
# Numero visible del bot, solo digitos. Obligatorio para evitar bucles
BOT_WHATSAPP_NUMBER=
# Ejemplo de formato: vNN.0 (usar la version vigente que muestre el panel de Meta)
META_GRAPH_VERSION=

# Redis / Valkey. Debe ser un plan CON persistencia
KV_URL=

# Asesor: numero distinto al del bot y plantilla aprobada con un parametro {{1}}
ADVISOR_NUMBER=
ADVISOR_TEMPLATE_NAME=
ADVISOR_TEMPLATE_LANG=es_MX

# Administracion (minimo 24 caracteres aleatorios; vacio = rutas /admin apagadas)
ADMIN_TOKEN=

# Google Sheets
SHEETS_ID_PROSPECTOS=
SHEETS_TAB_PROSPECTOS=Prospectos GastroRadar
GOOGLE_CREDENTIALS_JSON=

# IA (apagada hasta actualizar el aviso de privacidad y probar el modelo)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12
AI_MAX_INPUT_CHARS=600
AI_MAX_OUTPUT_TOKENS=300
AI_USER_DAILY_LIMIT=15
AI_GLOBAL_DAILY_LIMIT=300

USER_MSGS_PER_10MIN=20
WORKER_THREADS=3
# Encender solo con autorizacion y condiciones confirmadas
TPV_BENEFIT_VERIFIED=false
ONLINE_CONTRACTING_AVAILABLE=false
